# 仅纳入运行源码、构建入口、依赖清单和许可证；本地资料不删除。
/*
!/.gitignore
!/README.md
!/LICENSE-GPL-3.0.txt
!/LICENSE-LGPL-3.0.txt
!/Start-Asterhabit.ps1
!/THIRD_PARTY_NOTICES.md
!/asterhabit/
!/graphify/

/asterhabit/*
!/asterhabit/.gitignore
!/asterhabit/package.json
!/asterhabit/package-lock.json
!/asterhabit/requirements-memory.txt
!/asterhabit/local-runtime.example.json
!/asterhabit/companion/
!/asterhabit/shared/
!/asterhabit/characters/
!/asterhabit/licenses/
!/asterhabit/scripts/
!/asterhabit/desktop/

# 运行入口及其直接/间接依赖；验收、诊断和历史脚本不入库。
/asterhabit/scripts/*
!/asterhabit/scripts/desktop-run.mjs
!/asterhabit/scripts/desktop-build.mjs
!/asterhabit/scripts/desktop-service.mjs
!/asterhabit/scripts/backend-worker.mjs
!/asterhabit/scripts/credential-codec.ps1
!/asterhabit/scripts/protect-backend-directory.ps1
!/asterhabit/scripts/process-start.mjs
!/asterhabit/scripts/model-credentials.mjs
!/asterhabit/scripts/dialogue-protocol.mjs
!/asterhabit/scripts/migrate-application.mjs
!/asterhabit/scripts/find-application-writers.ps1

/asterhabit/desktop/*
!/asterhabit/desktop/.gitignore
!/asterhabit/desktop/package.json
!/asterhabit/desktop/package-lock.json
!/asterhabit/desktop/index.html
!/asterhabit/desktop/tsconfig.json
!/asterhabit/desktop/vite.config.ts
!/asterhabit/desktop/src/
!/asterhabit/desktop/public/
!/asterhabit/desktop/src-tauri/
/asterhabit/desktop/src-tauri/*
!/asterhabit/desktop/src-tauri/Cargo.toml
!/asterhabit/desktop/src-tauri/Cargo.lock
!/asterhabit/desktop/src-tauri/build.rs
!/asterhabit/desktop/src-tauri/tauri.conf.json
!/asterhabit/desktop/src-tauri/src/
!/asterhabit/desktop/src-tauri/capabilities/
!/asterhabit/desktop/src-tauri/permissions/
!/asterhabit/desktop/src-tauri/icons/
/asterhabit/desktop/src-tauri/icons/*
!/asterhabit/desktop/src-tauri/icons/icon.ico
!/asterhabit/desktop/src-tauri/icons/icon.png

/graphify/*
!/graphify/LICENSE
!/graphify/requirements.lock.txt

**/node_modules/
**/__pycache__/
**/*.pyc
**/*.test.*
**/*.spec.*
**/.env
**/.env.*
**/*.log
**/*.sqlite*
**/*.db
**/*.pem
**/*.key
